# 全環境共通の環境変数テンプレート
# ローカル開発: .env.development
# ステージング環境: .env.staging
# 本番環境: .env.production
#
# 実際の環境ファイルはGit管理対象外です。
# NEXT_PUBLIC_* はブラウザへ公開されるため、秘密情報を設定しないでください。
# Google Analytics の測定ID・AdSense の Publisher ID は公開識別子として扱います。
# Staging では Google ID を設定していても、NEXT_PUBLIC_DEPLOY_ENV によりタグは出力されません。
#
# デプロイ環境の設定例:
# development: NEXT_PUBLIC_DEPLOY_ENV=development
# staging: NEXT_PUBLIC_DEPLOY_ENV=staging
# production: NEXT_PUBLIC_DEPLOY_ENV=production
#
# Cloudflareステージング設定例:
# APPURL=https://startify-app-next-staging.<workers-subdomain>.workers.dev
# NEXT_PUBLIC_APPURL=https://startify-app-next-staging.<workers-subdomain>.workers.dev
# NEXT_PUBLIC_API_BASE_URL=https://api-staging.example.com/api/v1
# NEXT_PUBLIC_DEPLOY_ENV=staging
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_GOOGLE_ADSENSE_ID=

APPURL=https://example.com
APPNAME=Startify-App
APPDESCRIPTION=Startify-Appは、AI駆動の開発に対応するために設計されたウェブアプリケーション・ウェブサイトの開発環境です。
APPAUTHOR=DesignSupply.LLC

NEXT_PUBLIC_APPURL=https://example.com
NEXT_PUBLIC_APPNAME=Startify-App
NEXT_PUBLIC_APPDESCRIPTION=Startify-Appは、AI駆動の開発に対応するために設計されたウェブアプリケーション・ウェブサイトの開発環境です。
NEXT_PUBLIC_APPAUTHOR=DesignSupply.LLC
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
NEXT_PUBLIC_DEPLOY_ENV=development
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=
